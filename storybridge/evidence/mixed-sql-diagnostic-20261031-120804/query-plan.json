  "query": "SELECT r.head,r.floor_seq,m.* FROM room r JOIN membership a ON a.room_id=r.id AND a.user_id=%s LEFT JOIN message m ON m.room_id=r.id AND m.seq>GREATEST(%s,r.floor_seq-1) AND m.seq<=LEAST(%s,r.head) WHERE r.id=%s ORDER BY m.seq LIMIT 64",
